# Copy to .env and fill in your course API key:
#   cp .env.example .env
#
# The shared Nebius Token Factory key is provided by the course.
# Do NOT commit .env — it is gitignored.

NEBIUS_API_KEY=your-course-key-here

# baseline_runner.py reads these (litellm OpenAI-compatible route)
OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1
OPENAI_API_KEY=${NEBIUS_API_KEY}

# Optional: override Token Factory base URL (tf_client.py)
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
